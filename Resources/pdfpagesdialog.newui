              type: "Rect",
              pos: { type: "Point", x: 0, y: 4 },
              size: { type: "Size", width: 120, height: 17 }
            },
            name: "pagesValueCaption",
            style: {
              type: "LabelStyle",
              text: "Number of pages",
              wordWrap: true,
              font: { type: "Font", name: "Segoe UI", size: 12, bold: false, italic: false, strikeThrough: false, underlined: false },
