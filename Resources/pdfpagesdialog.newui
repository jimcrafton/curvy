            },
            desiredSize: { type: "Size", width: 120, height: 17 },
            desiredSizeOverride: true
          },
          {
            type: "TextField",
            text: "1",
            font: { type: "Font", name: "Segoe UI", size: 12, bold: false, italic: false, strikeThrough: false, underlined: false },
            bounds: {
              type: "Rect",
              pos: { type: "Point", x: 126, y: 3 },
              size: { type: "Size", width: 200, height: 20 }
            },
            name: "pagesValueField",
            desiredSize: { type: "Size", width: 200, height: 20 },
            desiredSizeOverride: true
          }
        ]
      },
      {
        type: "SubView",
        bounds: {
          type: "Rect",
          pos: { type: "Point", x: 12, y: 190 },
          size: { type: "Size", width: 406, height: 34 }
        },
        visible: true,
        name: "pagesHint",
        desiredSize: { type: "Size", width: 406, height: 34 },
        desiredSizeOverride: true,
        childViews: [
          {
            type: "Label",
            text: "For specific pages, list page numbers and ranges: 1,5,10 or 2-4,9.",
            textAlignment: "Left",
            bounds: {
              type: "Rect",
              pos: { type: "Point", x: 0, y: 0 },
              size: { type: "Size", width: 406, height: 35 }
            },
            style: {
              type: "LabelStyle",
              text: "For specific pages, list page numbers and ranges: 1,5,10 or 2-4,9.",
              wordWrap: true,
              font: { type: "Font", name: "Segoe UI", size: 12, bold: false, italic: false, strikeThrough: false, underlined: false },
              textAlignment: "Left"
            }
          }
        ]
      },
      {
        type: "SubView",
        bounds: {
          type: "Rect",
          pos: { type: "Point", x: 12, y: 232 },
          size: { type: "Size", width: 406, height: 30 }
        },
        visible: true,
        name: "pagesFooter",
        layout: {
          type: "FlexLayout",
          orientation: "Horizontal",
          crossAxisAlignment: "Center",
          spacing: 6
        },
        desiredSize: { type: "Size", width: 406, height: 30 },
        desiredSizeOverride: true,
        childViews: [
          {
            type: "SubView",
            visible: true,
            layoutParams: { type: "FlexLayoutParams", weight: 1 }
          },
          {
            type: "Button",
            defaultControl: true,
            text: "Import",
            bounds: {
              type: "Rect",
              pos: { type: "Point", x: 0, y: 1 },
              size: { type: "Size", width: 96, height: 28 }
            },
            name: "pagesImportButton",
            style: {
              type: "ThemedButtonStyle",
              font: { type: "Font", name: "Segoe UI", size: 12, bold: false, italic: false, strikeThrough: false, underlined: false }
            },
            desiredSize: { type: "Size", width: 96, height: 28 },
            desiredSizeOverride: true
          },
          {
            type: "Button",
            cancelControl: true,
            text: "Cancel",
            bounds: {
              type: "Rect",
              pos: { type: "Point", x: 102, y: 1 },
              size: { type: "Size", width: 96, height: 28 }
            },
            name: "pagesCancelButton",
            style: {
              type: "ThemedButtonStyle",
              font: { type: "Font", name: "Segoe UI", size: 12, bold: false, italic: false, strikeThrough: false, underlined: false }
            },
            desiredSize: { type: "Size", width: 96, height: 28 },
            desiredSizeOverride: true
          }
        ]
