"""GUI tests for myapp. Copy to <app>\tests\gui\test_myapp_gui.py, replace myapp / view names, run (needs an idle desktop):

    python test_myapp_gui.py --exe D:\code\myapp\build\Debug\myapp.exe          (add -k Typing, --list, --help ...)
"""
import sys

sys.path.insert(0, r"D:\code\newui\tools\guitest")

import newui_guitest
from newui_guitest import AppTestCase


class MyAppCase(AppTestCase):
    """Put the app's vocabulary (helpers) here and share it between test files. The exe comes from --exe."""


class StartUp(MyAppCase):
    def test_the_app_starts_and_speaks_the_protocol(self):          # read-only: sends no input
        self.assertTrue(self.app.running)
        self.assertGreater(self.app.find("rootview").w, 0)


class Typing(MyAppCase):
    def test_clicking_an_input_focuses_it_and_typing_fills_it(self):
        self.app.click("nameInput")                                  # a view you gave a name
        self.assertEqual("nameInput", self.app.focused_name())
        self.app.type("Hello")
        self.assertEqual("Hello", self.app.text_of("nameInput"))

    def test_background_work_is_polled_not_slept(self):
        self.app.wait_until(lambda: self.app.tree("itemsTree", 10), "the items tree to fill")   # idle != work done


class Menus(MyAppCase):
    def test_a_menu_item_can_be_chosen(self):
        self.app.choose_menu("mainMenuBar", "File", "Open")


if __name__ == "__main__":
    sys.exit(newui_guitest.main())
